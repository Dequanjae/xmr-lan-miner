{
  "manifest_version": 3,
  "name": "XMR LAN Miner",
  "version": "1.0.0",
  "description": "Browser-based Monero miner — auto-mines XMR using your CPU via WASM JIT",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["ws://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["worker.js", "randomx_fast.js", "vm.wasm", "dataset.wasm", "fma.wasm", "simd.wasm"],
      "matches": ["<all_urls>"]
    }
  ]
}